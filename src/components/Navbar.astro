---
import { SITE_TITLE } from "../scripts/const";
import ThemeButton from "./ThemeButton.astro";

const {title} = Astro.props;
const {DEV} = import.meta.env;

const items = [
    { href: '/about', label: 'About' },
    { href: '/blog', label: 'Blog' },
];
const { pathname } = Astro.url;
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="lu-navbar lu-navbar--fixed">
    <div class="lu-navbar__inner">
        <a class="lu-navbar__brand" href="/">{SITE_TITLE} {title ? `| ${title}` : ''}</a>
        {DEV ? <span class="lu-chip lu-chip--danger">DEV MODE</span> : ''}
        <nav class="lu-navbar__items" aria-label="メイン">
            {items.map(item => (
                <a
                    class:list={['lu-button', 'lu-button--sm', { 'lu-button--primary': isCurrent(item.href) }]}
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                    {item.label}
                </a>
            ))}
            <ThemeButton className="lu-button lu-button--sm lu-button--ghost" />
        </nav>
    </div>
</header>
