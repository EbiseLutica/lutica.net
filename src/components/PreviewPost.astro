---
import Blog from '../layouts/Blog.astro';
import type { Visibility } from '../scripts/blog';

type Props = {
    frontmatter: {
        title: string;
        description?: string;
        date: Date;
        visibility: Visibility;
    };
    html: string;
};

const { frontmatter, html } = Astro.props;
---

<Blog frontmatter={frontmatter}>
    <Fragment set:html={html} />
</Blog>
