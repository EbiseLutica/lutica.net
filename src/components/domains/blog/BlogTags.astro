---
/**
 * 記事のタグを「#タグ」形式の小さいテキストで並べる。link を指定すると各タグをタグ別ページへのリンクにする。
 */
export interface Props {
    tags?: string[];
    link?: boolean;
}

const { tags = [], link = false } = Astro.props;
---

{tags.length > 0 && (
    <ul class="tags lu-text-dimmed lu-text-small">
        {tags.map(tag => (
            <li>
                {link
                    ? <a href={`/blog/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
                    : <span>#{tag}</span>}
            </li>
        ))}
    </ul>
)}

<style lang="scss">
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: var(--space-1) 0 0;
        padding: 0;
        list-style: none;
    }

    a {
        color: inherit;
        text-decoration: none;

        &:hover {
            text-decoration: underline;
        }
    }
</style>
