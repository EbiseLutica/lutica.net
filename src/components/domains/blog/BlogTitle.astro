---

import { Icon } from 'astro-icon/components';
import { format } from 'date-fns';
export interface Props {
    path: string;
	frontmatter: Record<string, any>;
}

const { path, frontmatter } = Astro.props;

const dateString = isNaN((frontmatter.date as Date).getTime()) ? '不明' : format(frontmatter.date as Date, 'yyyy/MM/dd');
const isoString = isNaN((frontmatter.date as Date).getTime()) ? '' : (frontmatter.date as Date).toISOString();

---

<a href={path} class="lu-card lu-card--link lu-p-4">
    <article>
        <h2 class="title">{frontmatter.title}</h2>
        <aside class="lu-text-dimmed lu-text-small">
            <Icon name="tabler:calendar-event" /> <time datetime={isoString}>{dateString}</time>
            {frontmatter.draft ? <span class="lu-chip lu-chip--dimmed lu-ms-1">下書き</span> : null}
        </aside>
        <p>{frontmatter.description}</p>
    </article>
</a>

<style lang="scss">
    h2.title {
        margin: 0;
    }

    p {
        margin: var(--space-2) 0 0;
    }
</style>
