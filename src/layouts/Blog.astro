---
import Content from '../components/Content.astro';
import SnsShare from '../components/SnsShare.astro';
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { format } from 'date-fns';

const { frontmatter } = Astro.props;

const dateString = isNaN((frontmatter.date as Date).getTime()) ? '不明' : format(frontmatter.date as Date, 'yyyy/MM/dd');
const isoString = isNaN((frontmatter.date as Date).getTime()) ? '' : (frontmatter.date as Date).toISOString();

const shareTitle = `${frontmatter.title} - るちーかの長いノート`;
---

<Layout title={frontmatter.title} description={frontmatter.description} type="article">
    <Content>
        <article class="blog">
            <header class="hero">
                <h1>{frontmatter.title}</h1>
                <aside class="lu-text-dimmed">
                    <Icon name="tabler:calendar-event"/> <time datetime={isoString}>{dateString}</time>
                </aside>
            </header>
            <article class="lu-card lu-card--article lu-prose">
                <slot />
            </article>
            <footer class="article-footer">
                <SnsShare title={shareTitle} />
                <a class="lu-button" href="/blog">← ブログ一覧に戻る</a>
            </footer>
        </article>
    </Content>
</Layout>

<style lang="scss">
    .blog {
        header.hero {
            margin-bottom: var(--space-4);
            padding-bottom: var(--space-4);
            text-align: center;

            h1 {
                margin: 0;
            }
        }

        .article-footer {
            margin-top: var(--space-12);
            text-align: center;
        }
    }
</style>
