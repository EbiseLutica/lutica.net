---
import Navbar from '../components/Navbar.astro';
import 'photoswipe/style.css';
import 'photoswipe-dynamic-caption-plugin/photoswipe-dynamic-caption-plugin.css';
import '../styles/lutica-ds/tokens.css';
import '../styles/lutica-ds/bundle.css';
import '../styles/style.scss';
import { SITE_DESCRIPTION, SITE_TITLE } from '../scripts/const';

export interface Props {
	title?: string;
	description?: string;
	root?: boolean;
	/** og:type。記事ページは 'article' を指定する */
	type?: 'website' | 'article';
	/** RSSフィードの自動検出用 */
	feed?: { title: string; href: string };
}

const title = Astro.props.title ? `${Astro.props.title} | ${SITE_TITLE}` : SITE_TITLE;
const description = Astro.props.description ?? SITE_DESCRIPTION;
const ogType = Astro.props.type ?? 'website';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL('/favicon.png', Astro.site ?? Astro.url).href;
const themeColor = '#651622';
---

<!DOCTYPE html>
<html lang="ja">
	<head>
		<script is:inline>
			const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches
			const currentTheme = localStorage.getItem('theme') || 'system';
			const finalTheme = currentTheme === 'system' ? (preferred ? 'dark' : 'light') : currentTheme;
			document.documentElement.setAttribute('data-theme', finalTheme);
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<link href="https://unpkg.com/sanitize.css" rel="stylesheet"/>
		{Astro.props.feed && <link rel="alternate" type="application/rss+xml" title={Astro.props.feed.title} href={Astro.props.feed.href} />}
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="msapplication-TileColor" content={themeColor} />
		<meta name="theme-color" content={themeColor} />
		<meta property="og:type" content={ogType} />
			<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:image" content={ogImage} />
			<meta name="twitter:card" content="summary" />
	</head>
	<body id="root">
		<Navbar />
		<main>
			<slot />
		</main>
		<footer>
			<span class="lu-text-dimmed lu-text-small">(C)2023-{new Date().getFullYear()} Ebise Lutica all rights reserved.</span>
		</footer>
	</body>
</html>

<script>
	import PhotoSwipe from 'photoswipe';
	import PhotoSwipeLightbox from 'photoswipe/lightbox';

	const lightbox = new PhotoSwipeLightbox({
		gallery: '#root',
		children: '.item',
		pswpModule: PhotoSwipe,
	});

	lightbox.init();
</script>

<style lang="scss">
	main.non-root {
		margin-top: 32px;
	}

	main {
		padding-top: calc(var(--size-navbar) + var(--space-6) + var(--space-8));
		min-height: calc(100vh - 128px);
	}

	footer {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 128px;
	}
</style>
