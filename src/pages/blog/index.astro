---
import Content from '../../components/Content.astro';
import BlogTitle from '../../components/domains/blog/BlogTitle.astro';
import Layout from '../../layouts/Layout.astro';
import { countTags, getListedPosts } from '../../scripts/blog-posts';

const isDev = import.meta.env.DEV;

const posts = await getListedPosts();
const tags = countTags(posts);
---

<Layout title="ブログ" feed={{ title: 'るちーかの長いノート', href: '/blog/rss.xml' }}>
    <Content>
        <header class="lu-prose">
            <h1>るちーかの長いノート</h1>
            <p>
                普段Misskeyを使いすぎてブログというものを書かなすぎる（アドカレ置き場になっている）んですが、オタクというのは時折長く語りたくなるものなので……そんなものを置く場所です。
            </p>
            <p>
                暇な方、るちーかのファン、あるいはそれら以外全ての方、どうぞご覧ください。
            </p>
            <p><a href="/blog/rss.xml">RSSフィード</a></p>
            {isDev ? <aside class="lu-text-dimmed">（開発ビルドのため、限定公開・非公開の記事も表示しています）</aside> : null}
        </header>
        {tags.length > 0 && (
            <nav class="tags" aria-label="タグ">
                {tags.map(({ tag, count }) => (
                    <a class="lu-chip lu-chip--dimmed" href={`/blog/tags/${encodeURIComponent(tag)}`}>#{tag} ({count})</a>
                ))}
            </nav>
        )}
        <div class="lu-stack lu-stack--gap-4">
            {posts.map(p => <BlogTitle path={`/blog/${p.slug}`} frontmatter={p.data} />)}
        </div>
    </Content>
</Layout>

<style lang="scss">
    header {
        margin-bottom: var(--space-8);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-bottom: var(--space-8);

        a {
            text-decoration: none;
        }
    }
</style>
