---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import lutica from '../assets/lutica_chibi.png';
---

<Layout>
	<main class="root">
		<div class="lu-card lu-p-4 profile">
			<h1>るちーか</h1>
			<p class="description">ものづくりとゲームが好きです。</p>
			<img class="lutica-chibi-floating" src={lutica.src} alt="lutica" />
			<div class="_sns-buttons">
				<a href="https://mk.lutic.at/@lutica" style="--brand-bg: #A1CA03; --brand-fg: white" class="_sns-button" target="_blank" rel="noopener noreferrer">
					<Icon name="simple-icons:misskey" />
				</a>
				<a href="https://skeb.jp/@lutica" style="--brand-bg: #28837f" class="_sns-button" target="_blank" rel="noopener noreferrer">
					<Icon name="skeb" />
				</a>
				<a href="https://x.com/lutica_f" class="_sns-button" target="_blank" rel="noopener noreferrer">
					<Icon name="simple-icons:x" />
				</a>
				<a href="https://github.com/ebiselutica" class="_sns-button" target="_blank" rel="noopener noreferrer">
					<Icon name="simple-icons:github" />
				</a>
				<a href="https://soundcloud.com/lutica_sc" style="--brand-bg: #FF5500; --brand-fg: white" class="_sns-button" target="_blank" rel="noopener noreferrer">
					<Icon name="simple-icons:soundcloud" />
				</a>
			</div>
		</div>
		
		<div class="top-menu">
			<a href="/about" class="lu-card lu-card--link lu-p-4 menu-item">
				<h2 class="title">About</h2>
				<p>もっとくわしい　自己紹介</p>
			</a>
			<a href="/blog" class="lu-card lu-card--link lu-p-4 menu-item">
				<h2 class="title">Blog</h2>
				<p>ちょっと長い　話をつらつら</p>
			</a>
			<a href="/works" class="lu-card lu-card--link lu-p-4 menu-item">
				<h2 class="title">Works</h2>
				<p>いろんなモノ　つくってます</p>
			</a>
			<div class="lu-card lu-p-4 menu-item disabled">
				<h2 class="title">Characters</h2>
				<p>アバターと　うちの子</p>
				<aside>準備中...</aside>
			</div>
			<div class="lu-card lu-p-4 menu-item disabled">
				<h2 class="title">Gallery</h2>
				<p>描いた＆描いていただいた　イラスト集</p>
				<aside>準備中...</aside>
			</div>
			<a href="/gyagu" class="lu-card lu-card--link lu-p-4 menu-item">
				<h2 class="title">Gyagu*</h2>
				<p>このサイト　うるさいとｗ</p>
				<aside>
					*: gagではなく、gyaguです
				</aside>
			</a>
		</div>
	</main>
</Layout>

<script>
	// クリックで squash & stretch する。CSS の登場アニメを再実行させないよう Web Animations API で重ねる
	const chibi = document.querySelector<HTMLElement>('.lutica-chibi-floating');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	chibi?.addEventListener('click', () => {
		if (reduceMotion.matches) return;
		chibi.animate(
			[
				{ transform: 'scale(1, 1)' },
				{ transform: 'scale(1.15, 0.85)', offset: 0.2 },
				{ transform: 'scale(0.92, 1.08)', offset: 0.45 },
				{ transform: 'scale(1.04, 0.96)', offset: 0.7 },
				{ transform: 'scale(1, 1)' },
			],
			{ duration: 500, easing: 'ease-out' },
		);
	});
</script>

<style lang="scss">
$page-max-width: 500px;

@keyframes chibi-pop {
	from {
		opacity: 0;
		transform: translateY(24px);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

.root {
	display: flex;
	margin-top: 128px;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 0 var(--space-4);
	overflow-x: clip;

	.profile {
		width: 100%;
		max-width: $page-max-width;
		text-align: center;
		position: relative;

		h1 {
			margin: var(--space-4) 0 0;
			color: var(--primary);
		}

		.description {
			margin: var(--space-2) 0 var(--space-4);
		}

		.lutica-chibi-floating {
			position: absolute;
			right: -60px;
			top: -128px;;
			width: 249px;
			height: 191px;
			filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
			animation: chibi-pop 0.6s cubic-bezier(0, 0.82, 0.82, 1.29) both;
			cursor: pointer;
			transform-origin: 50% 100%;

			@media (prefers-reduced-motion: reduce) {
				animation: none;
			}

			:global(html[data-theme="dark"]) & {
				filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5)) brightness(0.6) saturate(1.2);
			}
		}
	}

	.top-menu {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		width: 100%;
		max-width: $page-max-width;
		margin: var(--space-8) var(--space-4) var(--space-4);

		.menu-item {
			&.disabled {
				opacity: 0.5;
				pointer-events: none;
			}

			h2 {
				margin: 0;
				padding-left: var(--space-2);
				border-left: 2px solid var(--brand);
				font-size: var(--text-h4);
			}

			p {
				margin: var(--space-2) 0 0 var(--space-2);
				font-size: var(--text-ui);
			}

			aside {
				margin: var(--space-2) 0 0 var(--space-2);
				color: var(--dimmed);
				font-size: var(--text-small);
			}
		}
	}
}
</style>
