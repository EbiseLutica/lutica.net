---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout>
	<main class="root">
		<div class="lu-card lu-p-4 profile">
			<h1>るちーか</h1>
			<p class="description">ものづくりとゲームが好きです。</p>
			<div class="_sns-buttons">
				<a href="https://mk.lutic.at/@lutica" style="--brand-bg: #A1CA03; --brand-fg: white" class="_sns-button" target="_blank" rel="noopener noreferrer">
					<Icon name="simple-icons:misskey" />
				</a>
				<a href="https://skeb.jp/@lutica" style="--brand-bg: #28837f" class="_sns-button" target="_blank" rel="noopener noreferrer">
					<Icon name="skeb" />
				</a>
				<a href="https://x.com/lutica_f" class="_sns-button" target="_blank" rel="noopener noreferrer">
					<Icon name="simple-icons:x" />
				</a>
				<a href="https://github.com/ebiselutica" class="_sns-button" target="_blank" rel="noopener noreferrer">
					<Icon name="simple-icons:github" />
				</a>
				<a href="https://soundcloud.com/lutica_sc" style="--brand-bg: #FF5500; --brand-fg: white" class="_sns-button" target="_blank" rel="noopener noreferrer">
					<Icon name="simple-icons:soundcloud" />
				</a>
			</div>
		</div>
		
		<div class="top-menu">
			<a href="/about" class="lu-card lu-card--link lu-p-4 menu-item">
				<h2 class="title">About</h2>
				<p>もっとくわしい　自己紹介</p>
			</a>
			<a href="/blog" class="lu-card lu-card--link lu-p-4 menu-item">
				<h2 class="title">Blog</h2>
				<p>ちょっと長い　話をつらつら</p>
			</a>
			<a href="/works" class="lu-card lu-card--link lu-p-4 menu-item">
				<h2 class="title">Works</h2>
				<p>いろんなモノ　つくってます</p>
			</a>
			<div class="lu-card lu-p-4 menu-item disabled">
				<h2 class="title">Characters</h2>
				<p>アバターと　うちの子</p>
				<aside>準備中...</aside>
			</div>
			<div class="lu-card lu-p-4 menu-item disabled">
				<h2 class="title">Gallery</h2>
				<p>描いた＆描いていただいた　イラスト集</p>
				<aside>準備中...</aside>
			</div>
			<a href="/gyagu" class="lu-card lu-card--link lu-p-4 menu-item">
				<h2 class="title">Gyagu*</h2>
				<p>このサイト　うるさいとｗ</p>
				<aside>
					*: gagではなく、gyaguです
				</aside>
			</a>
		</div>
	</main>
</Layout>

<style lang="scss">
$page-max-width: 500px;

.root {
	display: flex;
	margin-top: 128px;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 0 var(--space-4);

	.profile {
		width: 100%;
		max-width: $page-max-width;
		text-align: center;

		h1 {
			margin: var(--space-4) 0 0;
			color: var(--primary);
		}

		.description {
			margin: var(--space-2) 0 var(--space-4);
		}
	}

	.top-menu {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		width: 100%;
		max-width: $page-max-width;
		margin: var(--space-8) var(--space-4) var(--space-4);

		.menu-item {
			&.disabled {
				opacity: 0.5;
				pointer-events: none;
			}

			h2 {
				margin: 0;
				padding-left: var(--space-2);
				border-left: 2px solid var(--brand);
				font-size: var(--text-h4);
			}

			p {
				margin: var(--space-2) 0 0 var(--space-2);
				font-size: var(--text-ui);
			}

			aside {
				margin: var(--space-2) 0 0 var(--space-2);
				color: var(--dimmed);
				font-size: var(--text-small);
			}
		}
	}
}
</style>
