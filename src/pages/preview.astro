---
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import PreviewPost from '../components/PreviewPost.astro';

export const prerender = false;

// Decap / Sveltia の preview 用ページ (POST /preview)。
// CMS から送られた下書き (frontmatter + markdown 本文) を、実際のブログ記事と同じ Layout で描画して HTML を返す。
// 同一 origin からのリクエストのみ受け付ける。
let html = '';
let frontmatter = { title: '', description: undefined as string | undefined, date: new Date(NaN), draft: false };
let forbidden = false;

if (Astro.request.method === 'POST') {
    if (Astro.request.headers.get('origin') !== Astro.url.origin) {
        forbidden = true;
    } else {
        const data = (await Astro.request.json()) as {
            title?: string;
            description?: string;
            date?: string;
            draft?: boolean;
            body?: string;
        };
        // Workers では実行時の Wasm コンパイルが禁止されるため、Shiki のハイライトは無効化する
        const processor = await createMarkdownProcessor({ syntaxHighlight: false });
        const result = await processor.render(data.body ?? '');
        html = result.code;
        frontmatter = {
            title: data.title ?? '',
            description: data.description,
            date: new Date(data.date ?? ''),
            draft: data.draft ?? false,
        };
    }
}

if (forbidden) {
    Astro.response.status = 403;
}
---

{!forbidden && <PreviewPost frontmatter={frontmatter} html={html} />}
{forbidden && <p>Forbidden</p>}
